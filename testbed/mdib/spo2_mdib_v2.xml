<?xml version="1.0" encoding="UTF-8"?>
<!--
  spo2_mdib_v2.xml - testbed pulse oximeter, variant with TWO VMDs
    VMD spo2_vmd_sat   : SpO2 (LOINC 59408-5, UCUM %) + alert system with condition
                         "desaturation" (SNOMED CT 449171008, priority Me) and its signal
    VMD spo2_vmd_pulse : heart rate by pulse oximetry (LOINC 8889-8, UCUM /min) + alert
                         system with condition "tachycardia" (SNOMED CT 3424008, priority Me)
                         and its signal
  Derived from the first single-VMD version (not kept). Differences: two VMDs each with its own AlertSystem
  (SelfCheckPeriod PT10S each), two SetAlertState operations, no MDS Type element.
  Wrapper: msg:GetMdibResponse (same for every provider; see
  testbed/mdib/README.md).
  Constraints: MDIB_ANALYSIS.md Part C. All handles carry the prefix "spo2_".
  Per-run identity (patient, location, workflow context states, DPWS
  Manufacturer/ModelName/FriendlyName) is NOT in this file; the provider
  creates it at startup from its arguments. No static timestamps in this file.
  Terminology verified 2026-09-29: LOINC 8889-8 "Heart rate by Pulse oximetry"
  (tx.fhir.org LOINC 2.82, NLM Clinical Tables); SNOMED CT 449171008 "Oxygen
  saturation below reference range" and 3424008 "Tachycardia" (tx.fhir.org
  $lookup, SNOMED CT International Edition 20250201).
-->
<msg:GetMdibResponse
    xmlns:msg="http://standards.ieee.org/downloads/11073/11073-10207-2017/message"
    xmlns:pm="http://standards.ieee.org/downloads/11073/11073-10207-2017/participant"
    xmlns:ext="http://standards.ieee.org/downloads/11073/11073-10207-2017/extension"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    MdibVersion="0"
    SequenceId="urn:uuid:a1aee900-ec15-4f19-9f59-25aa05f39870">
  <msg:Mdib MdibVersion="0" SequenceId="urn:uuid:a1aee900-ec15-4f19-9f59-25aa05f39870">
    <pm:MdDescription DescriptionVersion="0">
      <pm:Mds Handle="spo2_mds">

        <pm:Sco Handle="spo2_sco">
          <pm:Operation xsi:type="pm:SetAlertStateOperationDescriptor" Handle="spo2_op_ack_desaturation"
                        OperationTarget="spo2_alert_signal_desaturation" Retriggerable="true">
            <pm:ModifiableData>Presence</pm:ModifiableData>
          </pm:Operation>
          <pm:Operation xsi:type="pm:SetAlertStateOperationDescriptor" Handle="spo2_op_ack_tachycardia"
                        OperationTarget="spo2_alert_signal_tachycardia" Retriggerable="true">
            <pm:ModifiableData>Presence</pm:ModifiableData>
          </pm:Operation>
          <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor" Handle="spo2_op_set_ensemble_ctx"
                        OperationTarget="spo2_ctx_ensemble" Retriggerable="true"/>
          <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor" Handle="spo2_op_set_workflow_ctx"
                        OperationTarget="spo2_ctx_workflow" Retriggerable="true"/>
        </pm:Sco>

        <pm:SystemContext Handle="spo2_system_context">
          <pm:PatientContext  xsi:type="pm:PatientContextDescriptor"  Handle="spo2_ctx_patient"/>
          <pm:LocationContext xsi:type="pm:LocationContextDescriptor" Handle="spo2_ctx_location"/>
          <pm:EnsembleContext xsi:type="pm:EnsembleContextDescriptor" Handle="spo2_ctx_ensemble"/>
          <pm:WorkflowContext xsi:type="pm:WorkflowContextDescriptor" Handle="spo2_ctx_workflow"/>
        </pm:SystemContext>

        <pm:Clock Handle="spo2_clock"/>

        <!-- VMD 1: oxygen saturation -->
        <pm:Vmd Handle="spo2_vmd_sat">
          <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="spo2_alert_system_sat" SelfCheckPeriod="PT10S">
            <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor" Handle="spo2_alert_cond_desaturation" Kind="Phy" Priority="Me">
              <pm:Type Code="449171008" CodingSystem="http://snomed.info/sct">
                <pm:ConceptDescription Lang="en">Oxygen saturation below reference range</pm:ConceptDescription>
              </pm:Type>
              <pm:Source>spo2_metric_spo2</pm:Source>
            </pm:AlertCondition>
            <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor" Handle="spo2_alert_signal_desaturation"
                            ConditionSignaled="spo2_alert_cond_desaturation"
                            Manifestation="Aud" Latching="false" AcknowledgementSupported="true"/>
          </pm:AlertSystem>
          <pm:Channel Handle="spo2_channel_sat">
            <pm:Metric xsi:type="pm:NumericMetricDescriptor" Handle="spo2_metric_spo2"
                       MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1" DeterminationPeriod="PT1S">
              <pm:Type Code="59408-5" CodingSystem="http://loinc.org">
                <pm:ConceptDescription Lang="en">Oxygen saturation in Arterial blood by Pulse oximetry</pm:ConceptDescription>
              </pm:Type>
              <pm:Unit Code="%" CodingSystem="http://unitsofmeasure.org">
                <pm:ConceptDescription Lang="en">percent</pm:ConceptDescription>
              </pm:Unit>
              <pm:TechnicalRange Lower="0" Upper="100"/>
            </pm:Metric>
          </pm:Channel>
        </pm:Vmd>

        <!-- VMD 2: pulse rate by pulse oximetry -->
        <pm:Vmd Handle="spo2_vmd_pulse">
          <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="spo2_alert_system_pulse" SelfCheckPeriod="PT10S">
            <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor" Handle="spo2_alert_cond_tachycardia" Kind="Phy" Priority="Me">
              <pm:Type Code="3424008" CodingSystem="http://snomed.info/sct">
                <pm:ConceptDescription Lang="en">Tachycardia</pm:ConceptDescription>
              </pm:Type>
              <pm:Source>spo2_metric_pulse</pm:Source>
            </pm:AlertCondition>
            <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor" Handle="spo2_alert_signal_tachycardia"
                            ConditionSignaled="spo2_alert_cond_tachycardia"
                            Manifestation="Aud" Latching="false" AcknowledgementSupported="true"/>
          </pm:AlertSystem>
          <pm:Channel Handle="spo2_channel_pulse">
            <pm:Metric xsi:type="pm:NumericMetricDescriptor" Handle="spo2_metric_pulse"
                       MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1" DeterminationPeriod="PT1S">
              <pm:Type Code="8889-8" CodingSystem="http://loinc.org">
                <pm:ConceptDescription Lang="en">Heart rate by Pulse oximetry</pm:ConceptDescription>
              </pm:Type>
              <pm:Unit Code="/min" CodingSystem="http://unitsofmeasure.org">
                <pm:ConceptDescription Lang="en">per minute</pm:ConceptDescription>
              </pm:Unit>
              <pm:TechnicalRange Lower="0" Upper="300"/>
            </pm:Metric>
          </pm:Channel>
        </pm:Vmd>

      </pm:Mds>
    </pm:MdDescription>

    <pm:MdState StateVersion="0">
      <!-- components -->
      <pm:State xsi:type="pm:MdsState"           DescriptorHandle="spo2_mds"            ActivationState="On"/>
      <pm:State xsi:type="pm:VmdState"           DescriptorHandle="spo2_vmd_sat"        ActivationState="On"/>
      <pm:State xsi:type="pm:VmdState"           DescriptorHandle="spo2_vmd_pulse"      ActivationState="On"/>
      <pm:State xsi:type="pm:ChannelState"       DescriptorHandle="spo2_channel_sat"    ActivationState="On"/>
      <pm:State xsi:type="pm:ChannelState"       DescriptorHandle="spo2_channel_pulse"  ActivationState="On"/>
      <pm:State xsi:type="pm:ClockState"         DescriptorHandle="spo2_clock"          ActivationState="On" RemoteSync="false"/>
      <pm:State xsi:type="pm:SystemContextState" DescriptorHandle="spo2_system_context" ActivationState="On"/>
      <pm:State xsi:type="pm:ScoState"           DescriptorHandle="spo2_sco"            ActivationState="On"/>

      <!-- alert systems: LastSelfCheck is set and refreshed by the provider at runtime (both) -->
      <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="spo2_alert_system_sat"          ActivationState="On"/>
      <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="spo2_alert_cond_desaturation"   ActivationState="On" Presence="false"/>
      <pm:State xsi:type="pm:AlertSignalState"    DescriptorHandle="spo2_alert_signal_desaturation" ActivationState="On" Presence="Off"/>
      <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="spo2_alert_system_pulse"        ActivationState="On"/>
      <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="spo2_alert_cond_tachycardia"    ActivationState="On" Presence="false"/>
      <pm:State xsi:type="pm:AlertSignalState"    DescriptorHandle="spo2_alert_signal_tachycardia"  ActivationState="On" Presence="Off"/>

      <!-- operations -->
      <pm:State xsi:type="pm:SetAlertStateOperationState"   DescriptorHandle="spo2_op_ack_desaturation" OperatingMode="En"/>
      <pm:State xsi:type="pm:SetAlertStateOperationState"   DescriptorHandle="spo2_op_ack_tachycardia"  OperatingMode="En"/>
      <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="spo2_op_set_ensemble_ctx" OperatingMode="En"/>
      <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="spo2_op_set_workflow_ctx" OperatingMode="En"/>

      <!-- metrics: initial values; DeterminationTime is set by the provider on every update -->
      <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="spo2_metric_spo2" ActivationState="On">
        <pm:MetricValue Value="97">
          <pm:MetricQuality Validity="Vld"/>
        </pm:MetricValue>
      </pm:State>
      <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="spo2_metric_pulse" ActivationState="On">
        <pm:MetricValue Value="72">
          <pm:MetricQuality Validity="Vld"/>
        </pm:MetricValue>
      </pm:State>

      <!-- ensemble slot: unassociated, no identification; the Dashboard updates it in place -->
      <pm:State xsi:type="pm:EnsembleContextState" DescriptorHandle="spo2_ctx_ensemble" Handle="spo2_ctx_ensemble_state" ContextAssociation="No"/>
    </pm:MdState>
  </msg:Mdib>
</msg:GetMdibResponse>
