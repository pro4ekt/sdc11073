<?xml version="1.0" encoding="UTF-8"?>
<!--
  ecg_mdib_v2.xml - testbed ECG monitor, variant with TWO VMDs
  (Python provider testbed/providers/testbed_provider.py on sdc11073 3.0.0)
    VMD ecg_vmd_hr : heart rate                            LOINC 8867-4  UCUM /min  alert tachycardia (SNOMED 3424008, Hi)
    VMD ecg_vmd_rr : respiratory rate by transthoracic impedance  LOINC 76270-8 UCUM /min  alert tachypnea (SNOMED 271823003, Me)
  Derived from the first single-VMD version (not kept) after the pattern of vent_mdib_v2.xml: two VMDs each with
  its own AlertSystem (SelfCheckPeriod PT10S), two SetAlertState operations, no MDS Type,
  complete MdState, explicit CodingSystem everywhere, no static timestamps.
  Second channel: impedance respiration is measured by every bedside ECG monitor through
  the ECG electrodes and has its own alarm (apnoea / tachypnoea); it was preferred over
  ST-segment deviation because LOINC has a dedicated, verifiable term for the method
  (76270-8, METHOD_TYP Impedance.transthoracic) and SNOMED CT has a matching finding
  (271823003 Tachypnea), whereas ST deviation only has per-lead LOINC terms.
  Wrapper msg:GetMdibResponse: identical to spo2_mdib_v2.xml / vent_mdib_v2.xml.
  Constraints: MDIB_ANALYSIS.md Part C. All handles carry the prefix "ecg_".
  Per-run identity (patient, location, workflow context states, DPWS
  Manufacturer/ModelName/FriendlyName) is NOT in this file; the provider
  creates it at startup from its arguments.
  Terminology verified 2026-09-30 (NLM Clinical Tables LOINC search, tx.fhir.org
  LOINC $lookup, SNOMED CT International 20250201 $lookup, UCUM $validate-code).
-->
<msg:GetMdibResponse
    xmlns:msg="http://standards.ieee.org/downloads/11073/11073-10207-2017/message"
    xmlns:pm="http://standards.ieee.org/downloads/11073/11073-10207-2017/participant"
    xmlns:ext="http://standards.ieee.org/downloads/11073/11073-10207-2017/extension"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    MdibVersion="0"
    SequenceId="urn:uuid:5991eddb-1f9f-4d7f-b3f5-2753690a8019">
  <msg:Mdib MdibVersion="0" SequenceId="urn:uuid:5991eddb-1f9f-4d7f-b3f5-2753690a8019">
    <pm:MdDescription DescriptionVersion="0">
      <pm:Mds Handle="ecg_mds">

        <pm:Sco Handle="ecg_sco">
          <pm:Operation xsi:type="pm:SetAlertStateOperationDescriptor" Handle="ecg_op_ack_tachycardia"
                        OperationTarget="ecg_alert_signal_tachycardia" Retriggerable="true">
            <pm:ModifiableData>Presence</pm:ModifiableData>
          </pm:Operation>
          <pm:Operation xsi:type="pm:SetAlertStateOperationDescriptor" Handle="ecg_op_ack_tachypnea"
                        OperationTarget="ecg_alert_signal_tachypnea" Retriggerable="true">
            <pm:ModifiableData>Presence</pm:ModifiableData>
          </pm:Operation>
          <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor" Handle="ecg_op_set_ensemble_ctx"
                        OperationTarget="ecg_ctx_ensemble" Retriggerable="true"/>
          <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor" Handle="ecg_op_set_workflow_ctx"
                        OperationTarget="ecg_ctx_workflow" Retriggerable="true"/>
        </pm:Sco>

        <pm:SystemContext Handle="ecg_system_context">
          <pm:PatientContext  xsi:type="pm:PatientContextDescriptor"  Handle="ecg_ctx_patient"/>
          <pm:LocationContext xsi:type="pm:LocationContextDescriptor" Handle="ecg_ctx_location"/>
          <pm:EnsembleContext xsi:type="pm:EnsembleContextDescriptor" Handle="ecg_ctx_ensemble"/>
          <pm:WorkflowContext xsi:type="pm:WorkflowContextDescriptor" Handle="ecg_ctx_workflow"/>
        </pm:SystemContext>

        <pm:Clock Handle="ecg_clock"/>

        <!-- VMD 1: heart rate -->
        <pm:Vmd Handle="ecg_vmd_hr">
          <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="ecg_alert_system_hr" SelfCheckPeriod="PT10S">
            <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor" Handle="ecg_alert_cond_tachycardia" Kind="Phy" Priority="Hi">
              <pm:Type Code="3424008" CodingSystem="http://snomed.info/sct">
                <pm:ConceptDescription Lang="en">Tachycardia</pm:ConceptDescription>
              </pm:Type>
              <pm:Source>ecg_metric_hr</pm:Source>
            </pm:AlertCondition>
            <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor" Handle="ecg_alert_signal_tachycardia"
                            ConditionSignaled="ecg_alert_cond_tachycardia"
                            Manifestation="Aud" Latching="false" AcknowledgementSupported="true"/>
          </pm:AlertSystem>
          <pm:Channel Handle="ecg_channel_hr">
            <pm:Metric xsi:type="pm:NumericMetricDescriptor" Handle="ecg_metric_hr"
                       MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1" DeterminationPeriod="PT1S">
              <pm:Type Code="8867-4" CodingSystem="http://loinc.org">
                <pm:ConceptDescription Lang="en">Heart rate</pm:ConceptDescription>
              </pm:Type>
              <pm:Unit Code="/min" CodingSystem="http://unitsofmeasure.org">
                <pm:ConceptDescription Lang="en">per minute</pm:ConceptDescription>
              </pm:Unit>
              <pm:TechnicalRange Lower="0" Upper="300"/>
            </pm:Metric>
          </pm:Channel>
        </pm:Vmd>

        <!-- VMD 2: respiratory rate by transthoracic impedance -->
        <pm:Vmd Handle="ecg_vmd_rr">
          <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="ecg_alert_system_rr" SelfCheckPeriod="PT10S">
            <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor" Handle="ecg_alert_cond_tachypnea" Kind="Phy" Priority="Me">
              <pm:Type Code="271823003" CodingSystem="http://snomed.info/sct">
                <pm:ConceptDescription Lang="en">Tachypnea</pm:ConceptDescription>
              </pm:Type>
              <pm:Source>ecg_metric_rr</pm:Source>
            </pm:AlertCondition>
            <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor" Handle="ecg_alert_signal_tachypnea"
                            ConditionSignaled="ecg_alert_cond_tachypnea"
                            Manifestation="Aud" Latching="false" AcknowledgementSupported="true"/>
          </pm:AlertSystem>
          <pm:Channel Handle="ecg_channel_rr">
            <pm:Metric xsi:type="pm:NumericMetricDescriptor" Handle="ecg_metric_rr"
                       MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1" DeterminationPeriod="PT1S">
              <pm:Type Code="76270-8" CodingSystem="http://loinc.org">
                <pm:ConceptDescription Lang="en">Respiratory rate by Impedance.transthoracic</pm:ConceptDescription>
              </pm:Type>
              <pm:Unit Code="/min" CodingSystem="http://unitsofmeasure.org">
                <pm:ConceptDescription Lang="en">per minute</pm:ConceptDescription>
              </pm:Unit>
              <pm:TechnicalRange Lower="0" Upper="120"/>
            </pm:Metric>
          </pm:Channel>
        </pm:Vmd>

      </pm:Mds>
    </pm:MdDescription>

    <pm:MdState StateVersion="0">
      <!-- components -->
      <pm:State xsi:type="pm:MdsState"           DescriptorHandle="ecg_mds"            ActivationState="On"/>
      <pm:State xsi:type="pm:VmdState"           DescriptorHandle="ecg_vmd_hr"         ActivationState="On"/>
      <pm:State xsi:type="pm:VmdState"           DescriptorHandle="ecg_vmd_rr"         ActivationState="On"/>
      <pm:State xsi:type="pm:ChannelState"       DescriptorHandle="ecg_channel_hr"     ActivationState="On"/>
      <pm:State xsi:type="pm:ChannelState"       DescriptorHandle="ecg_channel_rr"     ActivationState="On"/>
      <pm:State xsi:type="pm:ClockState"         DescriptorHandle="ecg_clock"          ActivationState="On" RemoteSync="false"/>
      <pm:State xsi:type="pm:SystemContextState" DescriptorHandle="ecg_system_context" ActivationState="On"/>
      <pm:State xsi:type="pm:ScoState"           DescriptorHandle="ecg_sco"            ActivationState="On"/>

      <!-- alert systems: LastSelfCheck is set and refreshed by the provider at runtime (both) -->
      <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="ecg_alert_system_hr"           ActivationState="On"/>
      <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="ecg_alert_cond_tachycardia"    ActivationState="On" Presence="false"/>
      <pm:State xsi:type="pm:AlertSignalState"    DescriptorHandle="ecg_alert_signal_tachycardia"  ActivationState="On" Presence="Off"/>
      <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="ecg_alert_system_rr"           ActivationState="On"/>
      <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="ecg_alert_cond_tachypnea"      ActivationState="On" Presence="false"/>
      <pm:State xsi:type="pm:AlertSignalState"    DescriptorHandle="ecg_alert_signal_tachypnea"    ActivationState="On" Presence="Off"/>

      <!-- operations -->
      <pm:State xsi:type="pm:SetAlertStateOperationState"   DescriptorHandle="ecg_op_ack_tachycardia"  OperatingMode="En"/>
      <pm:State xsi:type="pm:SetAlertStateOperationState"   DescriptorHandle="ecg_op_ack_tachypnea"    OperatingMode="En"/>
      <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="ecg_op_set_ensemble_ctx" OperatingMode="En"/>
      <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="ecg_op_set_workflow_ctx" OperatingMode="En"/>

      <!-- metrics: initial values; DeterminationTime is set by the provider on every update -->
      <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="ecg_metric_hr" ActivationState="On">
        <pm:MetricValue Value="72">
          <pm:MetricQuality Validity="Vld"/>
        </pm:MetricValue>
      </pm:State>
      <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="ecg_metric_rr" ActivationState="On">
        <pm:MetricValue Value="16">
          <pm:MetricQuality Validity="Vld"/>
        </pm:MetricValue>
      </pm:State>

      <!-- ensemble slot: unassociated, no identification; the Dashboard updates it in place -->
      <pm:State xsi:type="pm:EnsembleContextState" DescriptorHandle="ecg_ctx_ensemble" Handle="ecg_ctx_ensemble_state" ContextAssociation="No"/>
    </pm:MdState>
  </msg:Mdib>
</msg:GetMdibResponse>
