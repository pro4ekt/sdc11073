<?xml version="1.0" encoding="UTF-8"?>
<!--
  mdib_vent.xml — Dräger Evita Ventilator (Airway Pressure channel)
  IHE-PCD ACM 3-node ICU Ensemble Test Harness

  Ensemble key: patient_id="test-patient-1"  room="ICU-1"
  DPWS: Manufacturer="Draeger"  ModelName="Evita Ventilator"

  Alert:   al_vent_hi  (Priority="Hi")  Source: airway_pressure (LOINC 20053-5)
  Profile: sens=0.98, FAR=0.10  →  LR+ = 9.80
  RoC limit: 50.0 cmH2O/s
-->
<msg:GetMdibResponse
    xmlns:msg="http://standards.ieee.org/downloads/11073/11073-10207-2017/message"
    xmlns:pm="http://standards.ieee.org/downloads/11073/11073-10207-2017/participant"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://standards.ieee.org/downloads/11073/11073-10207-2017/extension"
    SequenceId="1">
    <msg:Mdib MdibVersion="1" SequenceId="1">
        <pm:MdDescription DescriptionVersion="1">
            <pm:Mds Handle="mds_vent">
                <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="mds_al_sys_vent"/>

                <pm:Sco Handle="sco_mds_vent">
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="opSetPatCtx"
                                  OperationTarget="PC.vent"
                                  Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="set_ensemble_context_op"
                                  OperationTarget="ens_ctx_vent"
                                  Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="set_workflow_context_op"
                                  OperationTarget="wf_ctx_vent"
                                  Retriggerable="true"/>
                </pm:Sco>

                <pm:MetaData>
                    <pm:Manufacturer>Draeger</pm:Manufacturer>
                    <pm:ModelName>Evita Ventilator</pm:ModelName>
                </pm:MetaData>

                <pm:SystemContext Handle="sys_ctx_vent">
                    <pm:PatientContext  xsi:type="pm:PatientContextDescriptor"  Handle="PC.vent"/>
                    <pm:LocationContext xsi:type="pm:LocationContextDescriptor" Handle="loc_ctx_vent"/>
                    <pm:EnsembleContext xsi:type="pm:EnsembleContextDescriptor" Handle="ens_ctx_vent"/>
                    <pm:WorkflowContext xsi:type="pm:WorkflowContextDescriptor" Handle="wf_ctx_vent"/>
                </pm:SystemContext>

                <pm:Clock Handle="clock_vent">
                    <pm:TimeProtocol Code="532225">
                        <pm:ConceptDescription Lang="en-us">NTPv4</pm:ConceptDescription>
                    </pm:TimeProtocol>
                </pm:Clock>

                <pm:Vmd Handle="vmd_vent">
                    <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="al_sys_vent">
                        <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor"
                                           Handle="al_vent_hi" Kind="Phy" Priority="Hi">
                            <pm:Type Code="MDC_ALERT_AIRWAY_PRES_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">High Airway Pressure Alert</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Source>airway_pressure</pm:Source>
                        </pm:AlertCondition>
                        <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor"
                                        Handle="al_signal_vent_hi"
                                        ConditionSignaled="al_vent_hi"
                                        Manifestation="Aud"
                                        SignalDelegationSupported="true"
                                        Latching="true">
                            <pm:Type Code="MDC_ALERT_AIRWAY_PRES_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">High Airway Pressure Signal</pm:ConceptDescription>
                            </pm:Type>
                        </pm:AlertSignal>
                    </pm:AlertSystem>

                    <pm:Channel Handle="ch_vent">
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor"
                                   Handle="airway_pressure"
                                   MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="0.1">
                            <pm:Type Code="20053-5" CodingSystem="urn:oid:2.16.840.1.113883.6.1">
                                <pm:ConceptDescription Lang="en">Airway Pressure Peak (cmH2O)</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="cmH2O"/>
                            <pm:TechnicalRange Lower="0" Upper="100"/>
                        </pm:Metric>
                    </pm:Channel>
                </pm:Vmd>
            </pm:Mds>
        </pm:MdDescription>

        <pm:MdState>
            <!-- ENSEMBLE KEY — identical in all 3 MDIBs -->
            <pm:State xsi:type="pm:PatientContextState"
                      DescriptorHandle="PC.vent"
                      Handle="PC.vent.state"
                      ContextAssociation="Assoc">
                <pm:Identification Root="1.2.840.10004.20701.1.1" Extension="test-patient-1">
                    <pm:IdentifierName/>
                </pm:Identification>
                <pm:CoreData>
                    <pm:Givenname>Test</pm:Givenname>
                    <pm:Familyname>Patient</pm:Familyname>
                </pm:CoreData>
            </pm:State>

            <pm:State xsi:type="pm:LocationContextState"
                      DescriptorHandle="loc_ctx_vent"
                      Handle="loc_ctx_vent.state"
                      ContextAssociation="Assoc">
                <pm:LocationDetail Room="ICU-1" Facility="TestHospital" Bed="Bed-A"/>
            </pm:State>

            <pm:State xsi:type="pm:EnsembleContextState"
                      DescriptorHandle="ens_ctx_vent"
                      Handle="ens_ctx_vent.state"
                      ContextAssociation="No">
                <pm:Identification Root="00000000-0000-0000-0000-000000000000" Extension="unbound">
                    <pm:IdentifierName/>
                </pm:Identification>
            </pm:State>

            <pm:State xsi:type="pm:WorkflowContextState"
                      DescriptorHandle="wf_ctx_vent"
                      Handle="wf_ctx_vent.state"
                      ContextAssociation="Assoc">
                <pm:WorkflowDetail>
                    <pm:Patient>
                        <pm:Identification Root="1.2.840.10004.20701.1.1" Extension="test-patient-1"/>
                    </pm:Patient>
                </pm:WorkflowDetail>
            </pm:State>

            <pm:State xsi:type="pm:VmdState"            DescriptorHandle="vmd_vent"         ActivationState="On"/>
            <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="mds_al_sys_vent"   ActivationState="On"/>
            <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="al_sys_vent"       ActivationState="On"/>
            <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="al_vent_hi"        ActivationState="On" Presence="false"/>
            <pm:State xsi:type="pm:AlertSignalState"    DescriptorHandle="al_signal_vent_hi" ActivationState="On" Presence="Off"/>

            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="opSetPatCtx"             OperatingMode="En"/>
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="set_ensemble_context_op" OperatingMode="En"/>
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="set_workflow_context_op" OperatingMode="En"/>

            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="airway_pressure">
                <pm:MetricValue Value="18.0"><pm:MetricQuality Validity="Vld"/></pm:MetricValue>
                <pm:PhysiologicalRange Lower="5" Upper="60"/>
            </pm:State>
        </pm:MdState>
    </msg:Mdib>
</msg:GetMdibResponse>

