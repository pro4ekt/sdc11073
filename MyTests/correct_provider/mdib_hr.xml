<?xml version="1.0" encoding="UTF-8"?>
<!--
  mdib_hr.xml — MDIB for "Acme Medical / CardioMon 100" (Dedicated HR Monitor)
  IHE-PCD ACM Ensemble Test Harness — provider_ensemble.py

  Ensemble key: patient_id="test-patient-1"  room="ICU-1"
  Both mdib_hr.xml and mdib_spo2.xml share IDENTICAL patient + location contexts
  so the SmartAlertAggregator binds them into ONE ensemble.

  Alert:   al_hr_hi  (Priority="Hi")  Source: hr_metric (LOINC 8867-4)
  Profile: CardioMon 100  sens=0.88, FAR=0.08  →  LR+=11.0
  Stage 2: Posterior_P≈0.917  risk=9.17 ≥5.0  →  ESCALATE
-->
<msg:GetMdibResponse
    xmlns:msg="http://standards.ieee.org/downloads/11073/11073-10207-2017/message"
    xmlns:pm="http://standards.ieee.org/downloads/11073/11073-10207-2017/participant"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://standards.ieee.org/downloads/11073/11073-10207-2017/extension"
    SequenceId="1">
    <msg:Mdib MdibVersion="1" SequenceId="1">
        <pm:MdDescription DescriptionVersion="1">
            <pm:Mds Handle="mds_hr">
                <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="mds_al_sys_hr"/>

                <pm:Sco Handle="sco_mds_hr">
                    <!-- Required for apply_ensemble_context (SmartAlertAggregator) -->
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="opSetPatCtx"
                                  OperationTarget="PC.hr"
                                  Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="set_ensemble_context_op"
                                  OperationTarget="ens_ctx_hr"
                                  Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="set_workflow_context_op"
                                  OperationTarget="wf_ctx_hr"
                                  Retriggerable="true"/>
                </pm:Sco>

                <!-- DPWS device identity — matched against ClinicalRiskFilter._DEVICE_PROFILES -->
                <pm:MetaData>
                    <pm:Manufacturer>Acme Medical</pm:Manufacturer>
                    <pm:ModelName>CardioMon 100</pm:ModelName>
                </pm:MetaData>

                <pm:SystemContext Handle="sys_ctx_hr">
                    <pm:PatientContext  xsi:type="pm:PatientContextDescriptor"  Handle="PC.hr"/>
                    <pm:LocationContext xsi:type="pm:LocationContextDescriptor" Handle="loc_ctx_hr"/>
                    <pm:EnsembleContext xsi:type="pm:EnsembleContextDescriptor" Handle="ens_ctx_hr"/>
                    <pm:WorkflowContext xsi:type="pm:WorkflowContextDescriptor" Handle="wf_ctx_hr"/>
                </pm:SystemContext>

                <!-- VMD: Heart Rate Monitor -->
                <pm:Vmd Handle="vmd_hr">
                    <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="al_sys_hr">
                        <!-- All AlertConditions MUST precede AlertSignals (BICEPS schema) -->
                        <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor"
                                           Handle="al_hr_hi" Kind="Phy" Priority="Hi">
                            <pm:Type Code="MDC_ALERT_HR_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Tachycardia Alert</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Source>hr_metric</pm:Source>
                        </pm:AlertCondition>
                        <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor"
                                        Handle="al_signal_hr_hi"
                                        ConditionSignaled="al_hr_hi"
                                        Manifestation="Aud"
                                        SignalDelegationSupported="true"
                                        Latching="true">
                            <pm:Type Code="MDC_ALERT_HR_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Tachycardia Signal</pm:ConceptDescription>
                            </pm:Type>
                        </pm:AlertSignal>
                    </pm:AlertSystem>

                    <pm:Channel Handle="ch_hr">
                        <!-- Heart Rate — LOINC 8867-4, RoC limit = 10 bpm/s -->
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor"
                                   Handle="hr_metric"
                                   MetricCategory="Msrmt"
                                   MetricAvailability="Cont"
                                   Resolution="1">
                            <pm:Type Code="8867-4" CodingSystem="urn:oid:2.16.840.1.113883.6.1">
                                <pm:ConceptDescription Lang="en">Heart Rate (bpm)</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="bpm"/>
                            <pm:TechnicalRange Lower="20" Upper="300"/>
                        </pm:Metric>
                    </pm:Channel>
                </pm:Vmd>
            </pm:Mds>
        </pm:MdDescription>

        <pm:MdState>
            <!-- ═══════════════════════════════════════════════════════════════
                 ENSEMBLE KEY — must match mdib_spo2.xml exactly:
                   patient Extension = "test-patient-1"
                   location Room     = "ICU-1"
                 SmartAlertAggregator uses (patient_id, room) as ensemble key.
            ════════════════════════════════════════════════════════════════ -->
            <pm:State xsi:type="pm:PatientContextState"
                      DescriptorHandle="PC.hr"
                      Handle="PC.hr.state"
                      ContextAssociation="Assoc">
                <pm:Identification Root="1.2.840.10004.20701.1.1" Extension="test-patient-1">
                    <pm:IdentifierName/>
                </pm:Identification>
                <pm:CoreData>
                    <pm:Givenname>Test</pm:Givenname>
                    <pm:Familyname>Patient</pm:Familyname>
                </pm:CoreData>
            </pm:State>

            <pm:State xsi:type="pm:LocationContextState"
                      DescriptorHandle="loc_ctx_hr"
                      Handle="loc_ctx_hr.state"
                      ContextAssociation="Assoc">
                <pm:LocationDetail Room="ICU-1" Facility="TestHospital" Bed="Bed-A"/>
            </pm:State>

            <pm:State xsi:type="pm:EnsembleContextState"
                      DescriptorHandle="ens_ctx_hr"
                      Handle="ens_ctx_hr.state"
                      ContextAssociation="No">
                <pm:Identification Root="00000000-0000-0000-0000-000000000000" Extension="unbound">
                    <pm:IdentifierName/>
                </pm:Identification>
            </pm:State>

            <pm:State xsi:type="pm:WorkflowContextState"
                      DescriptorHandle="wf_ctx_hr"
                      Handle="wf_ctx_hr.state"
                      ContextAssociation="Assoc">
                <pm:WorkflowDetail>
                    <pm:Patient>
                        <!-- Extension must match PatientContextState.Extension above -->
                        <pm:Identification Root="1.2.840.10004.20701.1.1" Extension="test-patient-1"/>
                    </pm:Patient>
                </pm:WorkflowDetail>
            </pm:State>

            <!-- VMD and alert system states -->
            <pm:State xsi:type="pm:VmdState"          DescriptorHandle="vmd_hr"         ActivationState="On"/>
            <pm:State xsi:type="pm:AlertSystemState"  DescriptorHandle="mds_al_sys_hr"  ActivationState="On"/>
            <pm:State xsi:type="pm:AlertSystemState"  DescriptorHandle="al_sys_hr"      ActivationState="On"/>
            <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="al_hr_hi"     ActivationState="On" Presence="false"/>
            <pm:State xsi:type="pm:AlertSignalState"  DescriptorHandle="al_signal_hr_hi" ActivationState="On" Presence="Off"/>

            <!-- Operation states -->
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="opSetPatCtx"            OperatingMode="En"/>
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="set_ensemble_context_op" OperatingMode="En"/>
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="set_workflow_context_op" OperatingMode="En"/>

            <!-- HR metric initial value -->
            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="hr_metric">
                <pm:MetricValue Value="80"><pm:MetricQuality Validity="Vld"/></pm:MetricValue>
                <pm:PhysiologicalRange Lower="40" Upper="180"/>
            </pm:State>
        </pm:MdState>
    </msg:Mdib>
</msg:GetMdibResponse>

