<?xml version="1.0" encoding="UTF-8"?>
<!--
  mdib_monitor.xml — Dräger Infinity Monitor (HR channel)
  IHE-PCD ACM 3-node ICU Ensemble Test Harness

  Ensemble key: patient_id="test-patient-1"  room="ICU-1"
  DPWS: Manufacturer="Draeger"  ModelName="Infinity Monitor"

  Alert:   al_monitor_hi  (Priority="Hi")  Source: hr_metric (LOINC 8867-4)
  Profile: sens=0.99, FAR=0.15  →  LR+ = 6.60
  Stage 2 (prior=0.005):
    Phase 1 alone:  Posterior_P≈0.032  risk=0.32  < 5.0  → SUPPRESS
    Phase 2 + Vent: P*≈0.245           risk=2.45  < 5.0  → SUPPRESS
    Phase 3 all:    P*≈0.794           risk=7.94  ≥ 5.0  → ESCALATE
-->
<msg:GetMdibResponse
    xmlns:msg="http://standards.ieee.org/downloads/11073/11073-10207-2017/message"
    xmlns:pm="http://standards.ieee.org/downloads/11073/11073-10207-2017/participant"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://standards.ieee.org/downloads/11073/11073-10207-2017/extension"
    SequenceId="1">
    <msg:Mdib MdibVersion="1" SequenceId="1">
        <pm:MdDescription DescriptionVersion="1">
            <pm:Mds Handle="mds_monitor">
                <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="mds_al_sys_monitor"/>

                <pm:Sco Handle="sco_mds_monitor">
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="opSetPatCtx"
                                  OperationTarget="PC.monitor"
                                  Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="set_ensemble_context_op"
                                  OperationTarget="ens_ctx_monitor"
                                  Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor"
                                  Handle="set_workflow_context_op"
                                  OperationTarget="wf_ctx_monitor"
                                  Retriggerable="true"/>
                </pm:Sco>

                <pm:MetaData>
                    <pm:Manufacturer>Draeger</pm:Manufacturer>
                    <pm:ModelName>Infinity Monitor</pm:ModelName>
                </pm:MetaData>

                <pm:SystemContext Handle="sys_ctx_monitor">
                    <pm:PatientContext  xsi:type="pm:PatientContextDescriptor"  Handle="PC.monitor"/>
                    <pm:LocationContext xsi:type="pm:LocationContextDescriptor" Handle="loc_ctx_monitor"/>
                    <pm:EnsembleContext xsi:type="pm:EnsembleContextDescriptor" Handle="ens_ctx_monitor"/>
                    <pm:WorkflowContext xsi:type="pm:WorkflowContextDescriptor" Handle="wf_ctx_monitor"/>
                </pm:SystemContext>

                <pm:Clock Handle="clock_monitor">
                    <pm:TimeProtocol Code="532225">
                        <pm:ConceptDescription Lang="en-us">NTPv4</pm:ConceptDescription>
                    </pm:TimeProtocol>
                </pm:Clock>

                <pm:Vmd Handle="vmd_monitor">
                    <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="al_sys_monitor">
                        <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor"
                                           Handle="al_monitor_hi" Kind="Phy" Priority="Hi">
                            <pm:Type Code="MDC_ALERT_HR_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Tachycardia / HR High Alert</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Source>hr_metric</pm:Source>
                        </pm:AlertCondition>
                        <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor"
                                        Handle="al_signal_monitor_hi"
                                        ConditionSignaled="al_monitor_hi"
                                        Manifestation="Aud"
                                        SignalDelegationSupported="true"
                                        Latching="true">
                            <pm:Type Code="MDC_ALERT_HR_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Tachycardia Signal</pm:ConceptDescription>
                            </pm:Type>
                        </pm:AlertSignal>
                    </pm:AlertSystem>

                    <pm:Channel Handle="ch_monitor">
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor"
                                   Handle="hr_metric"
                                   MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1">
                            <pm:Type Code="8867-4" CodingSystem="urn:oid:2.16.840.1.113883.6.1">
                                <pm:ConceptDescription Lang="en">Heart Rate (bpm)</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="bpm"/>
                            <pm:TechnicalRange Lower="20" Upper="300"/>
                        </pm:Metric>
                    </pm:Channel>
                </pm:Vmd>
            </pm:Mds>
        </pm:MdDescription>

        <pm:MdState>
            <!-- ENSEMBLE KEY — identical in all 3 MDIBs -->
            <pm:State xsi:type="pm:PatientContextState"
                      DescriptorHandle="PC.monitor"
                      Handle="PC.monitor.state"
                      ContextAssociation="Assoc">
                <pm:Identification Root="1.2.840.10004.20701.1.1" Extension="test-patient-1">
                    <pm:IdentifierName/>
                </pm:Identification>
                <pm:CoreData>
                    <pm:Givenname>Test</pm:Givenname>
                    <pm:Familyname>Patient</pm:Familyname>
                </pm:CoreData>
            </pm:State>

            <pm:State xsi:type="pm:LocationContextState"
                      DescriptorHandle="loc_ctx_monitor"
                      Handle="loc_ctx_monitor.state"
                      ContextAssociation="Assoc">
                <pm:LocationDetail Room="ICU-1" Facility="TestHospital" Bed="Bed-A"/>
            </pm:State>

            <pm:State xsi:type="pm:EnsembleContextState"
                      DescriptorHandle="ens_ctx_monitor"
                      Handle="ens_ctx_monitor.state"
                      ContextAssociation="No">
                <pm:Identification Root="00000000-0000-0000-0000-000000000000" Extension="unbound">
                    <pm:IdentifierName/>
                </pm:Identification>
            </pm:State>

            <pm:State xsi:type="pm:WorkflowContextState"
                      DescriptorHandle="wf_ctx_monitor"
                      Handle="wf_ctx_monitor.state"
                      ContextAssociation="Assoc">
                <pm:WorkflowDetail>
                    <pm:Patient>
                        <pm:Identification Root="1.2.840.10004.20701.1.1" Extension="test-patient-1"/>
                    </pm:Patient>
                </pm:WorkflowDetail>
            </pm:State>

            <pm:State xsi:type="pm:VmdState"            DescriptorHandle="vmd_monitor"         ActivationState="On"/>
            <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="mds_al_sys_monitor"   ActivationState="On"/>
            <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="al_sys_monitor"       ActivationState="On"/>
            <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="al_monitor_hi"        ActivationState="On" Presence="false"/>
            <pm:State xsi:type="pm:AlertSignalState"    DescriptorHandle="al_signal_monitor_hi" ActivationState="On" Presence="Off"/>

            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="opSetPatCtx"             OperatingMode="En"/>
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="set_ensemble_context_op" OperatingMode="En"/>
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="set_workflow_context_op" OperatingMode="En"/>

            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="hr_metric">
                <pm:MetricValue Value="75"><pm:MetricQuality Validity="Vld"/></pm:MetricValue>
                <pm:PhysiologicalRange Lower="40" Upper="180"/>
            </pm:State>
        </pm:MdState>
    </msg:Mdib>
</msg:GetMdibResponse>

