<?xml version="1.0" encoding="UTF-8"?>
<msg:GetMdibResponse xmlns:msg="http://standards.ieee.org/downloads/11073/11073-10207-2017/message" xmlns:pm="http://standards.ieee.org/downloads/11073/11073-10207-2017/participant" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ext="http://standards.ieee.org/downloads/11073/11073-10207-2017/extension" SequenceId="1">
    <msg:Mdib MdibVersion="1" SequenceId="1">
        <pm:MdDescription DescriptionVersion="1">
            <pm:Mds Handle="mds_1">
                <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="mds_al_system">
                </pm:AlertSystem>
                <pm:Sco Handle="sco_mds">
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor" Handle="opSetPatCtx" OperationTarget="PC.mds0" Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor" Handle="set_ensemble_context_op" OperationTarget="ens_context_descriptor" Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:SetContextStateOperationDescriptor" Handle="set_workflow_context_op" OperationTarget="wrkflow_context_descriptor" Retriggerable="true"/>
                    <pm:Operation xsi:type="pm:ActivateOperationDescriptor" Handle="actop.mds0_sco_0" OperationTarget="mds_1" Retriggerable="true"/>
                </pm:Sco>
                <pm:SystemContext Handle="sys_context_1">
                    <pm:PatientContext xsi:type="pm:PatientContextDescriptor" Handle="PC.mds0" />
                    <pm:LocationContext xsi:type="pm:LocationContextDescriptor" Handle="loc_context_descriptor" />
                    <pm:EnsembleContext xsi:type="pm:EnsembleContextDescriptor" Handle="ens_context_descriptor" />
                    <pm:WorkflowContext xsi:type="pm:WorkflowContextDescriptor" Handle="wrkflow_context_descriptor" />
                </pm:SystemContext>
                <pm:Clock Handle="clock">
                    <pm:TimeProtocol Code="532225">
                        <pm:ConceptDescription Lang="en-us">NTPv4</pm:ConceptDescription>
                    </pm:TimeProtocol>
                </pm:Clock>

                <!-- VMD 1: Temperature / Device-Health (SenseHat) -->
                <pm:Vmd Handle="vmd_1">
                    <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="al_system_temperature">
                        <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor" Handle="al_condition_temperature" Kind="Phy" Priority="None">
                            <pm:Type Code="MDC_ALERT_TEMP_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">High Temperature Alert</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Source>temperature</pm:Source>
                        </pm:AlertCondition>
                        <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor" Handle="al_signal_temperature" ConditionSignaled="al_condition_temperature"
                                        Manifestation="Aud" SignalDelegationSupported="true" Latching="true">
                            <pm:Type Code="MDC_ALERT_TEMP_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">High Temperature Alert Signal</pm:ConceptDescription>
                            </pm:Type>
                        </pm:AlertSignal>
                    </pm:AlertSystem>
                    <pm:Sco Handle="sco_1">
                        <pm:Operation xsi:type="pm:SetAlertStateOperationDescriptor" Handle="temperature_alert_control" OperationTarget="al_signal_temperature" Retriggerable="true">
                            <pm:ModifiableData>Presence</pm:ModifiableData>
                            <pm:ModifiableData>ActivationState</pm:ModifiableData>
                            <pm:ModifiableData>ActualSignalGenerationDelay</pm:ModifiableData>
                        </pm:Operation>
                        <pm:Operation xsi:type="pm:SetMetricStateOperationDescriptor" Handle="temperature_threshold_control" OperationTarget="temperature" Retriggerable="true" />
                        <pm:Operation xsi:type="pm:SetValueOperationDescriptor" Handle="numeric.ch0.vmd1_sco_0" OperationTarget="temperature" Retriggerable="true"/>
                        <pm:Operation xsi:type="pm:SetStringOperationDescriptor" Handle="string.ch0.vmd1_sco_0" OperationTarget="system_statemachine" Retriggerable="true"/>
                    </pm:Sco>
                    <pm:Channel Handle="sense-hat_channel_1">
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor" Handle="device_health" MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1">
                            <pm:Type Code="68480-6" CodingSystem="urn:oid:2.16.840.1.113883.6.1">
                                <pm:ConceptDescription Lang="en">Device Health Status (%)</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="%"></pm:Unit>
                            <pm:TechnicalRange Lower="0" Upper="100"></pm:TechnicalRange>
                        </pm:Metric>
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor" Handle="temperature" MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1">
                            <pm:Type Code="8310-5" CodingSystem="urn:oid:2.16.840.1.113883.6.1">
                                <pm:ConceptDescription Lang="en">Body temperature (°C)</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="°"></pm:Unit>
                        </pm:Metric>
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor" Handle="device_id" MetricCategory="Set" MetricAvailability="Cont" Resolution="1">
                            <pm:Type Code="DEV-ID-LOCAL" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Device Identifier</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="id" />
                        </pm:Metric>
                        <pm:Metric xsi:type="pm:EnumStringMetricDescriptor" Handle="system_statemachine" MetricCategory="Msrmt" MetricAvailability="Cont">
                            <pm:Unit Code="262656"/>
                            <pm:AllowedValue><pm:Value>Idle</pm:Value></pm:AllowedValue>
                            <pm:AllowedValue><pm:Value>Running</pm:Value></pm:AllowedValue>
                            <pm:AllowedValue><pm:Value>Aborted</pm:Value></pm:AllowedValue>
                            <pm:AllowedValue><pm:Value>Complete</pm:Value></pm:AllowedValue>
                        </pm:Metric>
                    </pm:Channel>
                </pm:Vmd>

                <!-- VMD 2: Humidity sensor -->
                <pm:Vmd Handle="vmd_2">
                    <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="al_system_humidity">
                        <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor" Handle="al_condition_humidity" Kind="Phy" Priority="None">
                            <pm:Source>humidity</pm:Source>
                        </pm:AlertCondition>
                        <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor" Handle="al_signal_humidity" ConditionSignaled="al_condition_humidity"
                                        Manifestation="Aud" SignalDelegationSupported="true" Latching="true">
                        </pm:AlertSignal>
                    </pm:AlertSystem>
                    <pm:Sco Handle="sco_2">
                        <pm:Operation xsi:type="pm:SetAlertStateOperationDescriptor" Handle="humidity_alert_control" OperationTarget="al_signal_humidity" Retriggerable="true">
                            <pm:ModifiableData>Presence</pm:ModifiableData>
                            <pm:ModifiableData>ActivationState</pm:ModifiableData>
                            <pm:ModifiableData>ActualSignalGenerationDelay</pm:ModifiableData>
                        </pm:Operation>
                        <pm:Operation xsi:type="pm:SetMetricStateOperationDescriptor" Handle="humidity_threshold_control" OperationTarget="humidity" Retriggerable="true" />
                    </pm:Sco>
                    <pm:Channel Handle="sense-hat_channel_2">
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor" Handle="humidity" MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1">
                            <pm:Type Code="12812-6" CodingSystem="urn:oid:2.16.840.1.113883.6.1">
                                <pm:ConceptDescription Lang="en">Relative Humidity (%)</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="%"></pm:Unit>
                        </pm:Metric>
                    </pm:Channel>
                </pm:Vmd>

                <!-- ═══════════════════════════════════════════════════════
                     VMD 3 — Vital Signs Monitor
                     IHE-PCD ACM AlarmCoordinator test target

                     al_hr_hi  (Priority="Hi")  Tachycardia
                       Source: hr_metric  LOINC 8867-4  RoC limit = 10 bpm/s
                       Acme profile: sensitivity=0.88, FAR=0.08  LR+=11.0
                       Stage 2: Posterior_P≈0.917  risk=9.17  ≥5.0 → ESCALATE

                     al_spo2_lo (Priority="Me")  Hypoxia
                       Source: spo2_metric LOINC 59408-5  RoC limit = 3 %/s
                       Acme profile: sensitivity=0.74, FAR=0.18  LR+≈4.11
                       Stage 2: Posterior_P≈0.804  risk=4.83  <5.0 → SUPPRESS
                ════════════════════════════════════════════════════════════ -->
                <pm:Vmd Handle="vmd_vitals">
                    <pm:AlertSystem xsi:type="pm:AlertSystemDescriptor" Handle="al_system_vitals">
                        <!-- Conditions MUST precede Signals (BICEPS schema order) -->
                        <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor"
                                           Handle="al_hr_hi" Kind="Phy" Priority="Hi">
                            <pm:Type Code="MDC_ALERT_HR_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Tachycardia Alert</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Source>hr_metric</pm:Source>
                        </pm:AlertCondition>
                        <pm:AlertCondition xsi:type="pm:AlertConditionDescriptor"
                                           Handle="al_spo2_lo" Kind="Phy" Priority="Me">
                            <pm:Type Code="MDC_ALERT_SPO2_LOW" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Hypoxia Alert</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Source>spo2_metric</pm:Source>
                        </pm:AlertCondition>
                        <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor"
                                        Handle="al_signal_hr_hi"
                                        ConditionSignaled="al_hr_hi"
                                        Manifestation="Aud" SignalDelegationSupported="true" Latching="true">
                            <pm:Type Code="MDC_ALERT_HR_HIGH" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Tachycardia Signal</pm:ConceptDescription>
                            </pm:Type>
                        </pm:AlertSignal>
                        <pm:AlertSignal xsi:type="pm:AlertSignalDescriptor"
                                        Handle="al_signal_spo2_lo"
                                        ConditionSignaled="al_spo2_lo"
                                        Manifestation="Aud" SignalDelegationSupported="true" Latching="true">
                            <pm:Type Code="MDC_ALERT_SPO2_LOW" CodingSystem="urn:oid:1.2.3.4.5">
                                <pm:ConceptDescription Lang="en">Hypoxia Signal</pm:ConceptDescription>
                            </pm:Type>
                        </pm:AlertSignal>
                    </pm:AlertSystem>
                    <pm:Channel Handle="vitals_channel">
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor"
                                   Handle="hr_metric"
                                   MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1">
                            <pm:Type Code="8867-4" CodingSystem="urn:oid:2.16.840.1.113883.6.1">
                                <pm:ConceptDescription Lang="en">Heart Rate (bpm)</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="bpm"/>
                            <pm:TechnicalRange Lower="20" Upper="300"/>
                        </pm:Metric>
                        <pm:Metric xsi:type="pm:NumericMetricDescriptor"
                                   Handle="spo2_metric"
                                   MetricCategory="Msrmt" MetricAvailability="Cont" Resolution="1">
                            <pm:Type Code="59408-5" CodingSystem="urn:oid:2.16.840.1.113883.6.1">
                                <pm:ConceptDescription Lang="en">Oxygen Saturation SpO2 (%)</pm:ConceptDescription>
                            </pm:Type>
                            <pm:Unit Code="%"/>
                            <pm:TechnicalRange Lower="50" Upper="100"/>
                        </pm:Metric>
                    </pm:Channel>
                </pm:Vmd>

            </pm:Mds>
        </pm:MdDescription>

        <pm:MdState>
            <pm:State xsi:type="pm:PatientContextState" DescriptorHandle="PC.mds0" Handle="Patient_Context" ContextAssociation="Assoc">
                <pm:Identification Root="1.2.840.10004.20701.1.1" Extension="example">
                    <pm:IdentifierName></pm:IdentifierName>
                </pm:Identification>
                <pm:CoreData>
                    <pm:Givenname></pm:Givenname>
                    <pm:Familyname></pm:Familyname>
                    <pm:Height MeasuredValue="0">
                        <pm:MeasurementUnit Code="123"></pm:MeasurementUnit>
                    </pm:Height>
                    <pm:Weight MeasuredValue="0">
                        <pm:MeasurementUnit Code="123"></pm:MeasurementUnit>
                    </pm:Weight>
                </pm:CoreData>
            </pm:State>
            <pm:State xsi:type="pm:LocationContextState" DescriptorHandle="loc_context_descriptor" Handle="loc_context_state" ContextAssociation="Assoc">
                <pm:LocationDetail Room="OR-1" Facility="ICU" Bed="MockBed" />
            </pm:State>
            <pm:State xsi:type="pm:EnsembleContextState" DescriptorHandle="ens_context_descriptor" Handle="ens_context_state" ContextAssociation="No">
                 <pm:Identification Root="b1111111-1111-1111-1111-111111111111" Extension="initial">
                     <pm:IdentifierName></pm:IdentifierName>
                 </pm:Identification>
            </pm:State>
            <pm:State xsi:type="pm:WorkflowContextState" DescriptorHandle="wrkflow_context_descriptor" Handle="wrkflow_context_state" ContextAssociation="Assoc">
                <pm:WorkflowDetail>
                    <pm:Patient>
                        <pm:Identification Root="1.2.840.10004.20701.1.1" Extension="example">
                        </pm:Identification>
                    </pm:Patient>
                    <pm:DangerCode Code="40275004" CodingSystem="http://snomed.info/sct">
                        <pm:ConceptDescription Lang="en">Contact dermatitis (temperature-sensitive patient)</pm:ConceptDescription>
                    </pm:DangerCode>
                    <pm:RelevantClinicalInfo>
                        <pm:Criticality>Hi</pm:Criticality>
                        <pm:Description></pm:Description>
                        <pm:RelatedMeasurement>
                            <pm:Value MeasuredValue="0">
                                <pm:MeasurementUnit Code="123"></pm:MeasurementUnit>
                            </pm:Value>
                        </pm:RelatedMeasurement>
                    </pm:RelevantClinicalInfo>
                </pm:WorkflowDetail>
            </pm:State>

            <!-- VMD 1 states -->
            <pm:State xsi:type="pm:VmdState" DescriptorHandle="vmd_1" ActivationState="On" />
            <pm:State xsi:type="pm:AlertSystemState"  DescriptorHandle="al_system_temperature" ActivationState="On" />
            <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="al_condition_temperature" ActivationState="On" Presence="false" />
            <pm:State xsi:type="pm:AlertSignalState" DescriptorHandle="al_signal_temperature" ActivationState="On" Presence="Off" />

            <!-- VMD 2 states -->
            <pm:State xsi:type="pm:VmdState" DescriptorHandle="vmd_2" ActivationState="On" />
            <pm:State xsi:type="pm:AlertSystemState"  DescriptorHandle="al_system_humidity" ActivationState="On" />
            <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="al_condition_humidity" ActivationState="On" Presence="false" />
            <pm:State xsi:type="pm:AlertSignalState" DescriptorHandle="al_signal_humidity" ActivationState="On" Presence="Off" />

            <!-- VMD 3 (vmd_vitals) states -->
            <pm:State xsi:type="pm:VmdState" DescriptorHandle="vmd_vitals" ActivationState="On" />
            <pm:State xsi:type="pm:AlertSystemState"    DescriptorHandle="al_system_vitals"    ActivationState="On" />
            <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="al_hr_hi"            ActivationState="On" Presence="false" />
            <pm:State xsi:type="pm:AlertSignalState"    DescriptorHandle="al_signal_hr_hi"     ActivationState="On" Presence="Off" />
            <pm:State xsi:type="pm:AlertConditionState" DescriptorHandle="al_spo2_lo"          ActivationState="On" Presence="false" />
            <pm:State xsi:type="pm:AlertSignalState"    DescriptorHandle="al_signal_spo2_lo"   ActivationState="On" Presence="Off" />

            <!-- Sco / operation states -->
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="opSetPatCtx" OperatingMode="En" />
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="set_ensemble_context_op" OperatingMode="En" />
            <pm:State xsi:type="pm:SetContextStateOperationState" DescriptorHandle="set_workflow_context_op" OperatingMode="En" />
            <pm:State xsi:type="pm:ActivateOperationState" DescriptorHandle="actop.mds0_sco_0" OperatingMode="En" />
            <pm:State xsi:type="pm:SetValueOperationState" DescriptorHandle="numeric.ch0.vmd1_sco_0" OperatingMode="En" />
            <pm:State xsi:type="pm:SetStringOperationState" DescriptorHandle="string.ch0.vmd1_sco_0" OperatingMode="En" />
            <pm:State xsi:type="pm:SetAlertStateOperationState" DescriptorHandle="temperature_alert_control" OperatingMode="En" />
            <pm:State xsi:type="pm:SetAlertStateOperationState" DescriptorHandle="humidity_alert_control" OperatingMode="En" />
            <pm:State xsi:type="pm:SetMetricStateOperationState" DescriptorHandle="temperature_threshold_control" OperatingMode="En" />
            <pm:State xsi:type="pm:SetMetricStateOperationState" DescriptorHandle="humidity_threshold_control" OperatingMode="En" />

            <!-- Metric states -->
            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="device_id">
                <pm:MetricValue Value="0"><pm:MetricQuality Validity="Vld" /></pm:MetricValue>
            </pm:State>
            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="device_health">
                <pm:MetricValue Value="0"><pm:MetricQuality Validity="Vld" /></pm:MetricValue>
            </pm:State>
            <pm:State xsi:type="pm:EnumStringMetricState" DescriptorHandle="system_statemachine">
                <pm:MetricValue Value="Idle"><pm:MetricQuality Validity="Vld" /></pm:MetricValue>
            </pm:State>
            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="humidity">
                <pm:MetricValue Value="0"><pm:MetricQuality Validity="Vld" /></pm:MetricValue>
                <pm:PhysiologicalRange Lower="18" Upper="35"></pm:PhysiologicalRange>
            </pm:State>
            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="temperature">
                <pm:MetricValue Value="36"><pm:MetricQuality Validity="Vld" /></pm:MetricValue>
                <pm:PhysiologicalRange Lower="30" Upper="45"></pm:PhysiologicalRange>
            </pm:State>
            <!-- VMD 3 vital signs -->
            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="hr_metric">
                <pm:MetricValue Value="80"><pm:MetricQuality Validity="Vld" /></pm:MetricValue>
                <pm:PhysiologicalRange Lower="40" Upper="180"/>
            </pm:State>
            <pm:State xsi:type="pm:NumericMetricState" DescriptorHandle="spo2_metric">
                <pm:MetricValue Value="98"><pm:MetricQuality Validity="Vld" /></pm:MetricValue>
                <pm:PhysiologicalRange Lower="80" Upper="100"/>
            </pm:State>
        </pm:MdState>
    </msg:Mdib>
</msg:GetMdibResponse>