#include <iostream>
#include <string>
#include <fcntl.h>
#include <termios.h>
#include <unistd.h>

// Возвращает double. Если данных нет, возвращает -1.0
double get_serial_data() {
    static int fd = -1;
    static std::string buffer = ""; // Буфер для склейки разорванных кусочков

    // 1. Открываем порт при первом вызове (O_NDELAY - не зависаем)
    if (fd < 0) {
        fd = open("/dev/serial0", O_RDWR | O_NOCTTY | O_NDELAY);
        if (fd < 0) return -1.0;

        struct termios tty;
        tcgetattr(fd, &tty);
        cfsetspeed(&tty, B115200);
        tty.c_cflag |= (CLOCAL | CREAD | CS8);
        tty.c_lflag &= ~(ICANON | ECHO | ECHOE | ISIG);
        tcsetattr(fd, TCSANOW, &tty);
    }

    // 2. Читаем всё, что успело прилететь, и дописываем в буфер
    char buf[256];
    int n = read(fd, buf, sizeof(buf) - 1);
    if (n > 0) {
        buf[n] = '\0';
        buffer += buf;
    }

    // 3. Если в буфере появился символ переноса строки (\n) - число готово!
    size_t pos = buffer.find('\n');
    if (pos != std::string::npos) {
        std::string line = buffer.substr(0, pos); // Отрезаем готовое число
        buffer.erase(0, pos + 1);                 // Удаляем его из буфера

        // 4. Безопасно превращаем текст в double
        if (!line.empty()) {
            try {
                return std::stod(line); // string to double
            } catch (...) {
                return -1.0; // Защита от случайного мусора (букв)
            }
        }
    }

    return -1.0; // Число еще не долетело до конца
}

// --- ТВОЙ ЧИСТЫЙ MAIN ---
int main() {
    std::cout << "Слушаю порт...\n";

    while (true) {
        // Достаем наше значение!
        double my_value = get_serial_data();

        // Если это не ошибка/пустота (-1.0), то работаем с числом
        if (my_value != -1.0) {
            std::cout << "Получен double: " << my_value << std::endl;

            // Если нужно, тут можно сделать математику
            // double voltage = my_value * (3.3 / 1023.0);
        }
    }

    return 0;
}